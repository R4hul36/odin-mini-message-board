<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <div class="page-container">   
        <header>
            <h1><%=title%></h1>
            <p>A little space to share your thoughts</p>
        </header>
        <main class="messages-container">
            <div class="message-header">
                <h2>Recent Messages</h2>
                <a href="/new">Create</a>
            </div>
            <% messages.forEach(message => { %>
                <article>
                    <p><%=message.user%></p>
                    <p><%=message.text%></p>
                    <a href="/message/<%= message.messageId %>">open</a>
                </article>
            <%})%>    
        </main>
        <footer></footer>
    </div>
</body>
</html>