<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="page-container">   
        <%- include('./partials/header')%>
        <div class="message-header">
                <h2>Recent Messages</h2>
                <a href="/new" class="new-btn">+ New</a>
        </div>
        <main class="message-container">
            <% messages.forEach(message => { %>
                <article>
                    <p><%=message.text%></p>
                    <p class="user-info"><%=message.user%> <span>.</span> <%= message.added.toLocaleString('en-US', {
                        dateStyle: 'medium',
                        timeStyle: 'short'
                    })%></p>   
                    <a href="/message/<%= message.messageId %>">open</a>
                </article>
            <%})%>    
        </main>
        <%- include('./partials/footer.ejs') %>
    </div>
</body>
</html>