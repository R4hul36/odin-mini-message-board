<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1><%=title%></h1>
    <div class="messages-container">
        <% messages.forEach(message => { %>
            <p><%=message.user%></p>
            <p><%=message.text%></p>
        <%})%>    
    </div>
</body>
</html>